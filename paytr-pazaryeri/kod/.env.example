# PayTR Mağaza Paneli > Bilgi sayfasındaki değerler. BURAYA GERÇEK ANAHTAR YAZIP DEPOYA KOYMAYIN.
# Replit'te bu dosyayı kullanmayın: aynı adlarla "Secrets" (kilit simgesi) bölümüne ekleyin.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# 1 = test işlemi (gerçek para çekilmez), 0 = canlı
PAYTR_TEST_MODE=1
# 1 = eksik/yanlış alanda PayTR hata mesajı döndürür (geliştirme sırasında)
PAYTR_DEBUG=1

# Uygulamanızın dışarıdan erişilen adresi (Replit: https://<proje>.replit.app)
SITE_URL=
# Boş bırakılırsa SITE_URL/odeme-sonuc?durum=... kullanılır
PAYTR_OK_URL=
PAYTR_FAIL_URL=

# Platform komisyonu (yüzde, en çok 2 ondalık). Örnek: 10 veya 12.5
PLATFORM_KOMISYON_YUZDE=10
# Yönetim uçları (transfer gönder, iade) için uzun rastgele bir değer
YONETIM_ANAHTARI=
PORT=3000
